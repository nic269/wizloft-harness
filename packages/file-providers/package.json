{
  "name": "@wizloft/harness-file-providers",
  "version": "0.2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./memory-context": {
      "types": "./dist/memory-context.d.ts",
      "import": "./dist/memory-context.js"
    },
    "./repository": {
      "types": "./dist/repository.d.ts",
      "import": "./dist/repository.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "typecheck": "pnpm --filter @wizloft/harness-kernel build && pnpm --filter @wizloft/harness build && tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@wizloft/harness": "workspace:*",
    "@wizloft/harness-kernel": "workspace:*"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nic269/wizloft-harness.git",
    "directory": "packages/file-providers"
  },
  "homepage": "https://github.com/nic269/wizloft-harness#readme",
  "bugs": {
    "url": "https://github.com/nic269/wizloft-harness/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
