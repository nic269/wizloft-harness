{
  "name": "@wizloft/harness-project",
  "version": "0.1.0-alpha.4",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "wizloft-harness-project": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "typecheck": "pnpm --filter @wizloft/harness-project^... build && tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@wizloft/harness": "workspace:*",
    "@wizloft/harness-authority": "workspace:*",
    "@wizloft/harness-cli-adapter": "workspace:*",
    "@wizloft/harness-commands": "workspace:*",
    "@wizloft/harness-context": "workspace:*",
    "@wizloft/harness-evidence": "workspace:*",
    "@wizloft/harness-kernel": "workspace:*",
    "@wizloft/harness-plugin-file-events": "workspace:*",
    "@wizloft/harness-plugin-file-memory": "workspace:*",
    "@wizloft/harness-plugin-memory-context": "workspace:*",
    "@wizloft/harness-plugin-repository-files": "workspace:*",
    "@wizloft/harness-validation": "workspace:*"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nic269/wizloft-harness.git",
    "directory": "packages/project"
  },
  "homepage": "https://github.com/nic269/wizloft-harness#readme",
  "bugs": {
    "url": "https://github.com/nic269/wizloft-harness/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
