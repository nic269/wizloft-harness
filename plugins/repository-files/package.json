{
  "name": "@wizloft/harness-plugin-repository-files",
  "version": "0.1.0-alpha.2",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "typecheck": "pnpm --filter @wizloft/harness-kernel build && pnpm --filter @wizloft/harness-authority build && pnpm --filter @wizloft/harness-context build && tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@wizloft/harness-authority": "workspace:*",
    "@wizloft/harness-context": "workspace:*",
    "@wizloft/harness-kernel": "workspace:*"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nic269/wizloft-harness.git",
    "directory": "plugins/repository-files"
  },
  "homepage": "https://github.com/nic269/wizloft-harness#readme",
  "bugs": {
    "url": "https://github.com/nic269/wizloft-harness/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
